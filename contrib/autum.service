[Unit]
Description=Autum local voice assistant
After=graphical-session.target pipewire.service ollama.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/Autum
Environment=PYTHONPATH=%h/Projects/Autum/src
ExecStart=/usr/bin/python3 -m autum
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
